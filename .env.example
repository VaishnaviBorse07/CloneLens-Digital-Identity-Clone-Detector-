# ==============================================================================
# CloneLens Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="CloneLens Digital Identity Clone Detector"
API_V1_PREFIX=/api

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite:///./clonelens.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clonelens

# Machine Learning & Detection Model Settings
IMAGE_MODEL_WEIGHTS_PATH=backend/ml/image_model/saved_models/custom_cnn_v1.pt
IMAGE_INPUT_SIZE=224
IMAGE_BATCH_SIZE=32

# Decision Fusion Weights (Image Weight + Text Weight should equal 1.0)
FUSION_IMAGE_WEIGHT=0.60
FUSION_TEXT_WEIGHT=0.40
FUSION_THRESHOLD_AUTHENTIC=0.70
FUSION_THRESHOLD_FAKE=0.40

# LLM & NLP Forensics Multi-Provider Configuration
# Provider Options:
#  - "mock"        : Zero-cost offline deterministic stylometrics (Entropy, Burstiness, TTR, Repetition)
#  - "gemini"      : Google Gemini (e.g. gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
#  - "openai"      : OpenAI (e.g. gpt-4o-mini, gpt-4o, gpt-3.5-turbo)
#  - "groq"        : Groq LPU (e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant)
#  - "huggingface" : Hugging Face Inference (e.g. roberta-base-openai-detector)
#  - "ollama"      : Local Ollama daemon (e.g. llama3, mistral)
LLM_PROVIDER=mock
LLM_MODEL_NAME=gemini-1.5-flash
LLM_API_KEY=
LLM_BASE_URL=

# Provider-Specific API Key Aliases (Optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=

# Security & Upload Constraints
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
