# CloneLens Backend Configuration
ENVIRONMENT=development
DEBUG=True
APP_NAME="CloneLens Backend"
API_V1_PREFIX="/api"

# Server Host & Port
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# Database Configuration
# SQLite default for zero-setup development, PostgreSQL for production
DATABASE_URL="sqlite:///./clonelens.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clonelens"

# ML Model Paths
IMAGE_MODEL_WEIGHTS_PATH="backend/ml/image_model/saved_models/custom_cnn_v1.pt"
IMAGE_INPUT_SIZE=224

# Decision Fusion Weights
FUSION_IMAGE_WEIGHT=0.60
FUSION_TEXT_WEIGHT=0.40
FUSION_THRESHOLD_AUTHENTIC=0.70
FUSION_THRESHOLD_FAKE=0.40

# LLM Provider Configuration
LLM_PROVIDER="mock"  # Options: mock, openai, gemini, huggingface
LLM_API_KEY=""
LLM_MODEL_NAME="gpt-4o-mini"
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"
